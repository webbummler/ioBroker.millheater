{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Millheater: Alle Prüfungen",
            "type": "shell",
            "command": "npm run lint && npm test && npm run check",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Millheater: RepoChecker",
            "type": "shell",
            "command": "npx @iobroker/repochecker https://github.com/webbummler/ioBroker.millheater main --env .env",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Millheater: Dev-Server starten",
            "type": "shell",
            "command": "npm run dev-server watch",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Millheater: Tests starten",
            "type": "shell",
            "command": "npm run dev-server -- stop && iobroker stop && npm run test:integration",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
                {
            "label": "Millheater: Übersetzung erstellen",
            "type": "shell",
            "command": "npm run translate",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}