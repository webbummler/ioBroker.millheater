{
  "name": "iobroker.millheater",
  "version": "0.1.1",
  "description": "Mill Heizung über die lokale API integrieren",
  "author": {
    "name": "webbummler",
    "email": "moin@webbummler.de"
  },
  "contributors": [
    {
      "name": "Mill International AS",
      "url": "https://github.com/Mill-International-AS"
    }
  ],
  "homepage": "https://github.com/webbummler/ioBroker.millheater",
  "license": "MIT",
  "keywords": [
    "Mill",
    "heater",
    "heating",
    "ioBroker",
    "climate-control",
    "local-api",
    "IoT"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/webbummler/ioBroker.millheater.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "async-mutex": "^0.5.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.5",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/webbummler/ioBroker.millheater/issues"
  },
  "readmeFilename": "README.md"
}
